<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dip">

    <CheckBox
        android:id="@+id/checkBox_StorageItemSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@null"
        android:buttonTint="@color/colorTextColor"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_alignBottom="@id/linearLayout_TextHolder"/>

    <ImageView
        android:id="@+id/imageView_Thumbnail"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:contentDescription="Thumbnail icon"
        android:src="@drawable/baseline_image_vector_24"
        android:layout_toEndOf="@id/checkBox_StorageItemSelect"
        android:layout_centerVertical="true"/>

    <LinearLayout
        android:id="@+id/linearLayout_TextHolder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:layout_toEndOf="@id/imageView_Thumbnail"
        android:layout_centerVertical="true">

        <TextView
            android:id="@+id/textView_Line1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:text="Line1"
            android:textColor="@color/colorTextColor"
            android:textSize="16sp" />

    </LinearLayout>

</RelativeLayout>