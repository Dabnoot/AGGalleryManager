<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Activity_Import">

    <TextView
        android:id="@+id/textView_Instructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_gravity="start"
        android:textAlignment="textStart"
        android:text="Select an image to serve as a thumbnail. Select next to continue."
        android:textColor="@color/colorTextColor"
        android:textSize="20sp" />

    <ListView
        android:id="@+id/listView_ThumbnailDownloadItems"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:textSize="24sp"
        android:scrollbarSize="20dp"
        android:layout_below="@id/textView_Instructions"
        android:layout_above="@+id/linearLayout_ButtonBar" />

    <LinearLayout
        android:id="@+id/linearLayout_ButtonBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">

        <Button
            android:id="@+id/button_Cancel"
            android:layout_width="149dp"
            android:layout_height="67dp"
            android:layout_marginEnd="20dp"
            android:onClick="buttonClick_Cancel"
            android:text="Cancel"
            android:textSize="24sp"
            app:backgroundTint="@color/colorButton" />

        <Button
            android:id="@+id/button_ItemSelectComplete"
            android:layout_width="149dp"
            android:layout_height="67dp"
            android:layout_marginEnd="20dp"
            android:onClick="buttonNextClick_ThumbnailSelected"
            android:text="Next"
            android:textSize="24sp"
            app:backgroundTint="@color/colorButton"
            android:enabled="false"/>

        <Button
            android:id="@+id/button_Skip"
            android:layout_width="149dp"
            android:layout_height="67dp"
            android:onClick="buttonNextClick_ThumbnailSkip"
            android:text="Skip"
            android:textSize="24sp"
            app:backgroundTint="@color/colorButton"
            android:enabled="true"/>

    </LinearLayout>








</RelativeLayout>